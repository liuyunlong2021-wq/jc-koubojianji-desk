{
  "name": "jc-koubojianji-desk",
  "description": "口播剪辑器：将确认过的口播整理为可导出的剪辑成片",
  "version": "1.2.3",
  "author": {
    "name": "YILS",
    "developer": "YILS",
    "email": "yils_lin@163.com",
    "url": "https://yils.blog/"
  },
  "homepage": "https://github.com/liuyunlong2021-wq/jc-koubojianji-desk",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env APP_EDITION=talking-head VITE_CJS_IGNORE_WARNING=true vite",
    "prebuild": "node build/scripts/setup-yt-dlp.js && node build/scripts/clean-build.js",
    "build": "cross-env APP_EDITION=talking-head vue-tsc && cross-env APP_EDITION=talking-head VITE_CJS_IGNORE_WARNING=true vite build && electron-builder --config electron-builder.talking-head.json5",
    "preview": "vite preview",
    "test": "node --require ./src/runtime/test-setup.cjs --experimental-test-module-mocks --test src/runtime/*.test.ts",
    "format": "prettier --write .",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node build/scripts/post-install.js",
    "lipo-ffmpeg": "node build/scripts/lipo-ffmpeg.js",
    "setup:funasr": "node build/scripts/setup-funasr.js",
    "setup:yt-dlp": "node build/scripts/setup-yt-dlp.js",
    "probe:funasr": "node build/scripts/setup-funasr.js --probe-only"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "ffmpeg-static": "^5.2.0",
    "i18next": "^25.4.0",
    "i18next-fs-backend": "^2.3.2"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/node": "^16.18.126",
    "@vitejs/plugin-vue": "^6.0.0",
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "i18next-vue": "^5.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "typescript": "5.6.2",
    "unocss": "^66.3.3",
    "vite": "^7.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vite-plugin-vue-devtools": "7.7.7",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-tsc": "3.0.1",
    "vuetify": "^3.11.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "ffmpeg-static"
    ],
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "electron",
      "esbuild",
      "vue-demi"
    ]
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.12.4"
  }
}
